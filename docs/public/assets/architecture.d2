# @title Animesh process architecture
# @description User surfaces communicate with one owner daemon, which controls local state, source refreshes, scheduling, and native notifications.

direction: right

classes: {
  surface: {
    shape: rectangle
    style: {
      fill: "#ffffff"
      stroke: "#b8b8b2"
      stroke-width: 1
      border-radius: 8
      font-color: "#111111"
      shadow: false
    }
  }
  owner: {
    shape: rectangle
    style: {
      fill: "#111111"
      stroke: "#111111"
      stroke-width: 2
      border-radius: 8
      font-color: "#ffffff"
      shadow: false
    }
  }
}

surfaces: user surfaces {
  style: {
    fill: "#fafaf8"
    stroke: "#d8d8d2"
    border-radius: 12
    font-size: 17
    shadow: false
  }
  cli: "CLI\none request, then exit" { class: surface }
  menu: "menu bar\nglance + refresh" { class: surface }
}

socket: "versioned IPC\nuser-private Unix socket" {
  class: surface
  style.fill: "#f3f3ef"
}

daemon: "animesh daemon\none owner process" { class: owner }

owned: daemon-owned state and effects {
  style: {
    fill: "#fafaf8"
    stroke: "#d8d8d2"
    border-radius: 12
    font-size: 17
    shadow: false
  }
  store: "SQLite\nlocal record" { class: surface }
  source: "AniList client\nnew observations" { class: surface }
  schedule: "refresh + release\nscheduling" { class: surface }
  notify: "native notification\nadapters" { class: surface }
}

surfaces.cli -> socket: {
  style.stroke: "#555555"
  target-arrowhead.style.fill: "#555555"
}
surfaces.menu -> socket: {
  style.stroke: "#555555"
  target-arrowhead.style.fill: "#555555"
}
socket -> daemon: {
  style.stroke: "#555555"
  target-arrowhead.style.fill: "#555555"
}
daemon -> owned.store: {
  style.stroke: "#555555"
  target-arrowhead.style.fill: "#555555"
}
daemon -> owned.source: {
  style.stroke: "#555555"
  target-arrowhead.style.fill: "#555555"
}
daemon -> owned.schedule: {
  style.stroke: "#555555"
  target-arrowhead.style.fill: "#555555"
}
daemon -> owned.notify: {
  style.stroke: "#555555"
  target-arrowhead.style.fill: "#555555"
}
