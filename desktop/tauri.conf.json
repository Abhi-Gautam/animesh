{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Animesh Command Center",
  "version": "0.7.2",
  "identifier": "dev.animesh.command-center",
  "build": {
    "beforeBuildCommand": "npm --prefix ui run build",
    "beforeDevCommand": "npm --prefix ui run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Animesh",
      "width": 1440,
      "height": 900,
      "minWidth": 900,
      "minHeight": 650
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb", "appimage"],
    "icon": ["icon.png", "../assets/AppIcon.icns"]
  }
}
